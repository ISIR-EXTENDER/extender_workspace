# Ignore submodules in src directory
src/*

# Except for README.md in src that insures the directory is tracked
!src/README.md

# Ignore build, install, and log directories
/build/
/install/
/log/
/docs/

# Ignore generated files and caches
*.pyc
__pycache__/

# Ignore local settings and editor temporary files
*.swp
*.swo
*.tmp
*.bak

# Optionally ignore other OS-specific files
.DS_Store

# Ignore vscode workspace config
*.vscode
*.code-workspace

# Plots
*.jpg

# Ignore local data
data/*
rosbag*

# Ignore uv python env
.venv/
